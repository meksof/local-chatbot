# send a chat message
POST http://localhost:11434/api/generate
Content-Type: application/json
Connection: keep-alive

{
  "model": "qwen3:8b",
  "stream": false,
  "prompt": "What is your model name and version ?"
}

HTTP/1.1 200  - OK
content-type: application/json; charset=utf-8
date: Sun, 18 Oct 2026 14:26:03 GMT
content-length: 53
###
# list all models
GET http://localhost:11434/api/tags
###
# list running models
GET http://localhost:11434/api/ps

HTTP/1.1 200  - OK
content-type: application/json; charset=utf-8
date: Mon, 12 Oct 2026 14:21:31 GMT
content-length: 13
connection: close
###
# show model details
# @name showModel
POST http://localhost:11434/api/show
Content-Type: application/json

{
    "model": "qwen3:8b"
}
###
# show result.capabilities
@capabilities = {{showModel.response.body.$.capabilities}}

# print capabilities
{{capabilities}}
###
# Bad request
POST http://localhost:11434/api/generate
Content-Type: application/json

{
    "fakeRequest": null
}

HTTP/1.1 404  - Not Found
content-type: application/json; charset=utf-8
date: Tue, 28 Jul 2026 09:29:54 GMT
content-length: 30
connection: close